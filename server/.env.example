# Local dev: SQLite file, zero setup. In production (Render) this is
# overridden with a real Postgres/Neon connection string as an env var.
DATABASE_URL="file:./dev.db"

# Passphrase used to log into the app (choose your own)
APP_PASSWORD="change-me"

# Random long secret used to sign session cookies
JWT_SECRET="change-me-too"

# Your Anthropic API key (server-side only, never exposed to the browser)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# Internal identifier, no need to change
APP_USER_EMAIL="me@fittrack.local"

PORT=4000
NODE_ENV=development
