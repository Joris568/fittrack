generator client {
  provider = "prisma-client-js"
}

// Local dev uses sqlite for zero-setup previews. The production build
// (render.yaml) switches this to postgresql via `npm run db:use-postgres`
// before generating the client — never edit this by hand for deployment.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
  tzOffsetMin Int    @default(0) // browser getTimezoneOffset(); lets server-side code group days like the user sees them

  programs      WorkoutProgram[]
  sessions      WorkoutSession[]
  foodLogs      FoodLogEntry[]
  goals         NutritionGoal[]
  bodyMetrics   BodyMetric[]
  progressPhotos ProgressPhoto[]
  favoriteFoods FavoriteFood[]
  recipes       Recipe[]
  insights      AiInsight[]
  chatMessages  ChatMessage[]
  achievements  Achievement[]
  plannedWorkouts PlannedWorkout[]
  profile       UserProfile?
  pushSubscriptions PushSubscription[]
  reminderSettings  ReminderSettings?
}

// ---------- Training ----------

model Exercise {
  id          String   @id @default(cuid())
  name        String   @unique
  muscleGroup String
  equipment   String?
  notes       String?
  guide       String?  // JSON ExerciseGuide, cached from an AI-written explanation
  isCustom    Boolean  @default(false)
  createdAt   DateTime @default(now())

  programExercises ProgramExercise[]
  setLogs          SetLog[]
}

model WorkoutProgram {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  days ProgramDay[]
}

model ProgramDay {
  id        String   @id @default(cuid())
  programId String
  program   WorkoutProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  name      String
  order     Int      @default(0)

  exercises ProgramExercise[]
  sessions  WorkoutSession[]
  plannedWorkouts PlannedWorkout[]
}

model ProgramExercise {
  id            String   @id @default(cuid())
  programDayId  String
  programDay    ProgramDay @relation(fields: [programDayId], references: [id], onDelete: Cascade)
  exerciseId    String
  exercise      Exercise   @relation(fields: [exerciseId], references: [id])
  order         Int      @default(0)
  targetSets    Int      @default(3)
  targetRepsMin Int      @default(8)
  targetRepsMax Int      @default(12)
  targetWeight  Float?
  targetRpe     Float?
  restSeconds   Int?
  notes         String?
}

model WorkoutSession {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  programDayId String?
  programDay   ProgramDay? @relation(fields: [programDayId], references: [id])
  date         DateTime @default(now())
  notes        String?
  finishedAt   DateTime?
  readiness    String?  // JSON {sleep, soreness, energy, score} from the pre-workout check
  rating       Int?     // 1 = too easy, 2 = good, 3 = crushed me
  layout       String?  // JSON: the user's own exercise order/swaps for this session
  createdAt    DateTime @default(now())

  setLogs SetLog[]
}

model SetLog {
  id               String   @id @default(cuid())
  workoutSessionId String
  workoutSession   WorkoutSession @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)
  exerciseId       String
  exercise         Exercise @relation(fields: [exerciseId], references: [id])
  setNumber        Int
  reps             Int
  weight           Float
  rpe              Float?
  notes            String?
  isPR             Boolean  @default(false)
  isWarmup         Boolean  @default(false)
  clientId         String?  // set by the app so a retried (offline-queued) set is never stored twice (plain index, not unique: a unique constraint would make `prisma db push` demand --accept-data-loss on deploy)
  createdAt        DateTime @default(now())

  @@index([clientId])
}

// ---------- Nutrition ----------

model FoodItem {
  id            String   @id @default(cuid())
  source        String   // "openfoodfacts" | "custom"
  barcode       String?  @unique
  name          String
  brand         String?
  caloriesPer100g Float
  proteinPer100g  Float
  carbsPer100g    Float
  fatPer100g      Float
  fiberPer100g    Float?
  createdAt     DateTime @default(now())

  logEntries FoodLogEntry[]
  recipe     Recipe?
  favoritedBy FavoriteFood[]

  @@index([name])
}

model Recipe {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id])
  name               String
  sourceText         String
  servings           Int
  caloriesPerServing Float
  proteinPerServing  Float
  carbsPerServing    Float
  fatPerServing      Float
  ingredients        String   // JSON-encoded array of {name, quantity, estimatedCalories}
  foodItemId         String?  @unique
  foodItem           FoodItem? @relation(fields: [foodItemId], references: [id])
  createdAt          DateTime @default(now())
}

model FoodLogEntry {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  foodItemId     String
  foodItem       FoodItem @relation(fields: [foodItemId], references: [id])
  date           DateTime @default(now())
  mealType       String   // breakfast | lunch | dinner | snack
  quantityGrams  Float
  createdAt      DateTime @default(now())
}

model NutritionGoal {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  calories      Int
  proteinGrams  Int
  carbsGrams    Int
  fatGrams      Int
  effectiveFrom DateTime @default(now())
  createdAt     DateTime @default(now())
}

model BodyMetric {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  date       DateTime @default(now())
  weightKg   Float
  bodyFatPct Float?
  waistCm    Float?
  chestCm    Float?
  shoulderCm Float?
  armCm      Float?
  thighCm    Float?
  hipCm      Float?
  createdAt  DateTime @default(now())
}

model ProgressPhoto {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  date      DateTime @default(now())
  imageData String   // base64 data URL — fine at personal-app scale, avoids needing external file storage
  notes     String?
  createdAt DateTime @default(now())
}

model FavoriteFood {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  foodItemId String
  foodItem   FoodItem @relation(fields: [foodItemId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([userId, foodItemId])
}

// ---------- AI ----------

model AiInsight {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String   // workout_suggestion | nutrition_advice | weekly_report
  content   String   // JSON-encoded payload, shape depends on `type`
  status    String   @default("pending") // pending | accepted | dismissed
  createdAt DateTime @default(now())

  @@index([userId, type, createdAt])
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  role      String   // user | assistant
  content   String
  images    String?  // JSON array of base64 data URLs attached to this message
  imageKind String?  // "screenshot" (shown to the coach in-chat) | "progress" (also saved as progress photos)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// ---------- Gamification ----------

model Achievement {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  key        String   // matches a key in the ACHIEVEMENTS catalog
  unlockedAt DateTime @default(now())

  @@unique([userId, key])
}

// ---------- Agenda ----------

// A workout the user planned for a specific calendar day. `date` is a local-day key
// ("YYYY-MM-DD") rather than a timestamp, so it never shifts across timezones.
model PlannedWorkout {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  date         String
  programDayId String?
  programDay   ProgramDay? @relation(fields: [programDayId], references: [id], onDelete: SetNull)
  title        String?
  notes        String?
  sessionId    String?  // set when the planned workout was started from the agenda
  done         Boolean  @default(false) // manual check-off, e.g. for a free-text plan like "cardio"
  createdAt    DateTime @default(now())

  @@index([userId, date])
}

// ---------- AI usage ----------

// One row per Claude API call, so the app can show how much it is actually using.
model AiUsage {
  id               String   @id @default(cuid())
  createdAt        DateTime @default(now())
  label            String   // coach | checkin | advice | ...
  model            String
  inputTokens      Int
  outputTokens     Int
  cacheReadTokens  Int      @default(0)
  cacheWriteTokens Int      @default(0)

  @@index([createdAt])
}

// ---------- Profile & coach memory ----------

model UserProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  heightCm    Int?
  birthYear   Int?
  sex         String?  // male | female
  activity    String?  // sedentary | light | moderate | active | very_active (daily life, excluding training)
  goal        String?  // bulk | cut | maintain
  experience  String?  // beginner | intermediate | advanced
  trainDays   Int?     // intended training days per week
  injuries    String?
  coachNotes  String?  // JSON array of short facts the coach should remember
  checkinHandledAt DateTime? // when the weekly calorie check-in was last applied or dismissed
  priorityMuscles  String?   // JSON array of muscle groups the user wants to emphasise
  updatedAt   DateTime @updatedAt
}

// ---------- Push notifications ----------

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

model ReminderSettings {
  id           String  @id @default(cuid())
  userId       String  @unique
  user         User    @relation(fields: [userId], references: [id])
  trainingOn   Boolean @default(true)
  trainingTime String  @default("17:00")
  weighOn      Boolean @default(true)
  weighTime    String  @default("08:30")
  foodOn       Boolean @default(true)
  foodTime     String  @default("20:30")
  weeklyOn     Boolean @default(true)
  sentLog      String? // JSON array of "type:YYYY-MM-DD" keys already handled
}

// Small key/value store for secrets the app generates itself (the Web Push VAPID keys).
model AppSecret {
  key   String @id
  value String
}
